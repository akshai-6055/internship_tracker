# Copy this file to .env for local development
# On Railway/Render, set these as Environment Variables

# Django
SECRET_KEY=your-secret-key
DEBUG=False
ALLOWED_HOSTS=your-app.up.railway.app,your-app.onrender.com,localhost

# Database - Railway often provides MYSQL_URL or DATABASE_URL
# If you have one of those, you don't need the individual DB_* variables below
DATABASE_URL=mysql://root:password@containers-us-west-1.railway.app:3306/railway
# OR individual variables:
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your-password
DB_HOST=containers-us-west-1.railway.app
DB_PORT=3306

# Admin user (created automatically on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
ADMIN_EMAIL=admin@example.com
